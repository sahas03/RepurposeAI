# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file.

# --- General ---
PROJECT_NAME="Repurpose AI"
ENVIRONMENT=development
DEBUG=true
APP_VERSION=1.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://repurpose:repurpose@localhost:5432/repurpose_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Dev/test only - never set true in production:
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage ---
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=repurpose-ai-datasets
S3_REGION=us-east-1
S3_USE_SSL=true

# --- Uploads ---
MAX_UPLOAD_SIZE=52428800
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xlsx,xls,fasta,fa,fastq,fq,tsv

# --- Rate limiting / caching ---
RATE_LIMIT_PER_MINUTE=120
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DASHBOARD_TTL_SECONDS=60
CACHE_REFERENCE_DATA_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# --- ML ---
ML_MODEL_VERSION=1.0.0
ML_MODEL_DIR=./models
ML_RANDOM_STATE=42

# --- First superuser (used by scripts/create_admin.py defaults) ---
FIRST_SUPERUSER_EMAIL=admin@repurpose.ai
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
FIRST_SUPERUSER_NAME="Platform Admin"
